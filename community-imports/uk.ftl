money-tracker-always = Також стежити, коли вікно закрите
money-tracker-always-help = Завжди стежити за платежами, навіть якщо програма спостереження за грошима закрита.
money-tracker-copy-all = Копіювати все (CSV)
money-tracker-copy-some = Копіювати { $count } (CSV)
money-tracker-clear = Очистити
money-tracker-quoted = “{ $text }”
money-tracker-kind-sale = Продаж об' єктів
money-tracker-kind-purchase = Купівля об' єкта
money-tracker-kind-gift = Подарунок
money-tracker-kind-pay-object = Об' єкт платежу
money-tracker-kind-object-pays = Оплатити об’ єктом
money-tracker-kind-land = Країна
money-tracker-kind-land-pass = Пропуск на землю
money-tracker-kind-land-deed = Земельний договір
money-tracker-kind-group-create = Створення групи
money-tracker-kind-group-join = Оплата за вступ до групи
money-tracker-kind-upload = Оплата за вивантаження
money-tracker-kind-classified = Офіційне оголошення
money-tracker-kind-other = Операція
money-tracker-system = Сплатили системі
money-tracker-legacy-time = Час
money-tracker-legacy-name = Назва
money-tracker-legacy-amount = Кількість
money-tracker-legacy-summary = Сплачене: L$ { $paid } - Отримано: L$ { $received }
