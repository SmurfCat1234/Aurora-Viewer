# Director — capture and animations
director-capture = Sti for hånd
director-capture-start = Ta opp min sti
director-capture-start-tip = Fly kameraet som du vil at det skal filmes (alt-kamera, gratis kamera eller flycam): Visningen holdes tjue ganger i sekundet, og Stopp gjør den til nøkkelbilder i tempoet du fløy.
director-capture-taking =
    Ta opp banen din: { $time }, { $views ->
        [one] { $views } vis
       *[other] { $views } visninger
    }
director-capture-stop = Stopp og lag nøkkelbilder
director-capture-stop-tip = Banen blir til nøkkelbilder etter sporets slutt, i samme tempo som du fløy den. Ctrl+Z tar den tilbake.
director-capture-cancel-tip = Slipp denne banen (Escape).
director-capture-detail = Detaljer
director-capture-detail-tip = Hvor tett nøkkelbildene følger banen din: Mer detaljerte beholder sine mindre bevegelser, med flere nøkkel bilder.
director-capture-hint = Banen din legges til etter slutten av sporet, eller blir sporet når det er tomt.
director-capture-done =
    Din vei ble { $count ->
        [one] { $count } nøkkelramme
       *[other] { $count } nøkkelbilder
    } over { $time }.
director-capture-short = Banen var for kort til å spille: ta opp litt lenger.
director-capture-full = Sporet har ikke plass igjen for denne banen.
director-capture-dropped = Banen ble droppet: Direktøren lukket, en teleport begynte eller RLVa begrenset kameraet.
director-capture-restricted = RLVa begrenser kameraet: ingen bane kan registreres.
director-key-anim = Animasjon
director-key-anim-none = Ingen
director-key-anim-tip = En animasjon av inventaret ditt som avataren din spiller når sporet passerer denne nøkkelbilden (eller slipp en her fra inventaret). Uansett hva sporet startet stopper når avspillingen slutter.
director-key-anim-missing = { $name } (mangler)
director-key-anim-missing-tip = Denne animasjonen er ikke lenger i inventaret ditt: avspillingen hopper over den.
director-key-anim-clear = Ingen animasjon her
director-key-anim-until = Til
director-key-anim-until-tip = Hvor animasjonen stopper: ved en senere nøkkelramme, eller når avspillingen slutter.
director-key-anim-end = Slutt på avspilling
director-key-anim-stops = Stopp
director-key-anim-stops-tip = En animasjon som en tidligere nøkkelramme startet, stopper her.
director-key-anim-stops-clear = La det spille på
director-key-lens-time = Objektiv og tid på dagen
director-key-aperture = Blenderåpning
director-key-aperture-tip = Denne nøkkelbildens dybdeskarphet; mellom to nøkkelrammer endres den jevnt.
director-key-focus = Fokus
director-key-focus-tip = Avstanden denne keyframe er fokusert på, i stedet for sporets (målet eller dets fokusavstand).
director-key-hour = Tid på dagen
director-key-hour-tip = Solen ved denne nøkkelbilden, bare i ditt eget syn: ingenting blir sendt til området. Mellom to nøkkelrammer beveger den seg jevnlig; din egen himmel kommer tilbake når avspillingen slutter.
director-key-track-value = Sporets verdi
director-key-live = Nivå
director-key-set = Sett
director-key-set-tip = Gi denne nøkkelbilden en egen verdi.
director-key-unset = Tilbake til sporets verdi
director-key-unset-live = Tilbake til live-himmelen
director-title = Regissør
director-tab-track = Spor
director-tab-camera = Kamera
director-tab-look = Se.
director-tab-output = Utdata
director-tab-library = Bibliotek
director-tab-filters = Filtre
director-filters-note = Filtre og LUT-er i bildevinduet: én stabel for bilder og filmer, sporet filmes og gjengis med den.
director-freeze-world-tip = Som i Photo-vinduet: Avatarer, animasjoner og alt som beveger seg holder seg stille, kameraet forblir fritt.Et spor som spilles gjennom en frossen verden roterer rundt et stillhetsøkte.
director-thumb-missing-tip = Ingen bilder av denne visningen ennå: den er tatt når keyframen legges eller oppdateres, på Gå til, og når sporet spilles gjennom den.
director-camera = Kamera
director-lens = Visningsvinkel
director-roll = Liste
director-roll-reset = Nivålegg visningen
director-free-camera = Gratis kamera
director-free-camera-tip = Kameraet forlater avataren: fly den med bevegelsestastene, se deg rundt med høyre museknapp.
director-free-speed = Fart
director-keyframe-title = Nøkkelramme
director-keyframe-none = Velg en nøkkelramme på tidslinjen eller i verden for å redigere den.
director-keyframe = Nøkkelramme { $number }
director-keyframe-at = Nøkkelramme { $number } ved { $time }
director-key-time = Tid
director-go-to = Gå til
director-go-to-tip = Flytt kameraet til denne nøkkelbilden for å se gjennom den eller justere den. Et dobbeltklikk på nøkkelbildet gjør det samme.
director-update = Oppdater
director-update-tip = Erstatt denne nøkkelrammen med gjeldende visning.
director-delete = Slett
director-path = Sti
director-curve-smooth = Kurve
director-curve-linear = Rette linjer
director-even-speed = Jevn hastighet
director-even-speed-tip = Flytter nøkkelbildene på tidslinjen slik at kameraet holder samme hastighet langs hele banen. Varigheten endres ikke.
director-ease = Jevn start og slutt
director-ease-tip = Kameraet forlater den første nøkkelbilden fra hvile og kommer til hvile på den siste.
director-show-path = Vis veien i verden
director-summary =
    { $count ->
        [one] { $count } nøkkelramme
       *[other] { $count } nøkkelbilder
    } · { $seconds } s · { $meters } m
director-playback = Avspilling
director-start-delay = Startforsinkelse
director-start-delay-tip = Den første visningen holdes så lenge før kameraet forlater, med grensesnittet allerede skjult: tiden til å starte opptak.
director-hide-huds = Skjul HUD-ene mens du spiller
director-loop = Løkke
director-clear = Tøm sporet
director-clear-tip = Tøm sporet: hver nøkkelramme går (spør først; Angre bringer dem tilbake)
director-clear-confirm = - Fjerne sporet?
director-clear-confirm-text =
    { $count ->
        [one] Nøkkelrammen er slettet. Angre (Ctrl+Z) bringer den tilbake.
       *[other] Dets { $count } nøkkelbilder slettes. Angre (Ctrl+Z) bringer dem tilbake.
    }
director-clear-action = Fjern
director-environment = Miljø
director-rewind = Tilbake til startsiden
director-play = Spill av sporet. Grensesnittet er skjult, og Escape stopper.
director-play-needs-keys = Legg til minst to nøkkelbilder for å spille av sporet.
director-restricted = RLVa begrenser kameraet: sporet kan ikke spilles av og visningen kan ikke låses.
director-add-keyframe = Nøkkelramme
director-add-keyframe-tip = Legg til en nøkkelramme med gjeldende visning: hvor kameraet er, hvor det ser og synsvinkelen.
director-track-full = Sporet er fullt.
director-starts-in =
    { $seconds ->
        [one] Starter i { $seconds } sekund
       *[other] Starter i { $seconds } sekunder
    }
director-stop-hint = Esc for å stoppe
director-key-time-tip = Når kameraet er på denne nøkkelbilden. Bare denne nøkkellinnstillingen flyttes mellom sine to naboer.
director-span-time = Segmentvarighet
director-span-time-tip = Tiden kameraet tar fra forrige nøkkelbilde til dette. Nøkkelbildene etter det beveger seg med det, slik at de andre segmentene holder sin egen fart.
director-span-speed = Segmenthastighet
director-span-speed-tip = Kameraets gjennomsnittshastighet fra forrige nøkkelbilde til dette. En ny hastighet endrer segmentets varighet; nøkkelbildet etter det flyttes med den.
director-span-speed-still = Kameraet beveger seg ikke på dette segmentet: det bare roterer eller zoomer. Sett varigheten i stedet.
director-duration = Total varighet
director-duration-tip = Strekker eller forkorter hvert segment likt: hele sporet langsommere eller raskere.
director-keyframe-hint = Dra: Flytt den i tid. Shift + dra: Flytter også nøkkelbildene etter at den er flyttet. Dobbeltklikk: Gå til den.
director-keyframe-pick-hint = Ctrl + klikk: Legg til i utvalg eller fjern fra utvalg. Skift + trykk: Velg alle nøkkelbilder opp til den.
director-key-group = { $count } Keyframes valgt: en innstilling endret her går til alle av dem (deres plass, tittel og tid forblir sine egne).
director-key-rest = Stopp på denne nøkkelbilden
director-key-rest-tip = Kameraet bremser ned til et stopp på denne nøkkelbilden og forlater den forsiktig, i stedet for å passere gjennom med høy hastighet.
director-key-lock = Lås visningen på målet
director-key-lock-tip = Denne nøkkelbildens egen lås, uavhengig av de andre nøkkelbiledene og live- kameraet. På, den ser på sitt mål når sporet spilles (låsens mål, tatt når det er slått på); av, der kameraet ble lagt.
director-key-aim = Ser på
director-key-aim-tip = Hva visningen ser på når sporet spiller denne nøkkelbilden Mellom to nøkkel bilder, skifter den jevnlig fra det en ser på til det neste gjør.
director-key-aim-lock-on = Låsens mål: { $target }
director-key-aim-lock-off = Hvor kameraet er lagt (det følger låsen, som er av)
director-key-aim-free = Hvor kameraet er lagt
director-aim-joint = { $target } · { $joint }
director-key-aim-take = Bruk låsens mål
director-key-aim-take-tip = Denne nøkkelruta ser på målet som er valgt under Lås, slik det er nå. Den beholder det når låsen endrer mål eller slås av.
director-hide-pointer = Skjul musepekeren mens du spiller
director-lock = Lås
director-lock-on = Lås visningen på målet
director-lock-on-tip = Målet forblir i midten av visningen uansett hvor du flytter kameraet, uten at det er nødvendig med nøkkelbilder. En nøkkelbild som legges til mens visningen er låst, blir låst på dette målet, selv om du velger en annen etterpå. Hver nøkkelfil beholder sin egen låsing, satt i sin rad i Spor-fanen.
director-lock-target = Mål
director-lock-own = Min avatar
director-lock-avatar = En annen avatar
director-lock-object = Et objekt
director-lock-pick-own = Min avatar
director-lock-pick-focus = Kamerafokus
director-lock-pick-focus-tip = Alt + klikk på en avatar eller et objekt for å fokusere kameraet på det, og trykk deretter på denne knappen: visningen låses på den avataren (selv gjennom hva den har på seg) eller på det objektet.
director-lock-joint = Kroppsdel
director-lock-smoothing = Utjevning
director-lock-smoothing-tip = Hvor lang tid det tar for bildet å komme seg opp til målet. Ved 0 følger det alle bevegelser, inkludert hvert trinn i en dans. Høyere følger den som en kameraoperatør.
director-lock-lost = Et mål er ikke i sikte: der det blir sett på, er utsikten fri.
director-joint-head = Hode
director-joint-neck = Hals
director-joint-chest = Bryst
director-joint-pelvis = Bekken
director-joint-left-hand = Venstre hånd
director-joint-right-hand = Høyre hånd
director-picture = Bilde
director-format = Format
director-format-tip = Filmens proporsjoner. Mens du redigerer, er rammen omkranset og det som ligger utenfor den er nedtonet. Mens sporet spilles av, skjuler svarte stolper det.
director-format-window = Vindu
director-thirds = Tredjedelsregelen
director-delete-tip = Slett de valgte nøkkelbildene (Delete)
director-undo = Angre (Ctrl+Z)
director-redo = Gjør om (Ctrl+Y)
director-isolate-empty = Tom bakgrunn
director-isolate-empty-tip = Ingen himmel, jord, vann eller skyer rundt det som vises: en ren bakgrunn for å kutte motivet ut av filmen.
director-key-color = Bakgrunnsfarge
director-key-color-tip = Fyll den tomme bakgrunnen med en helfarge, først grønn: en grønn skjerm, for å markere ut når du redigerer filmen. Velg en farge som motivet ikke har på seg.
director-record = Opptak
director-record-looking = Ser etter ffmpeg …
director-record-missing = ffmpeg er ikke installert: det er et gratis program som koder filmen.
director-record-missing-hint = Installer den (i en Windows-terminal: winget install ffmpeg), og trykk deretter på "Se igjen"; eller velg filen hvis du allerede har den.
director-record-site = Nedlastingsside
director-record-choose = Velg ffmpeg & # 160; …
director-record-again = Se igjen
director-record-found = Koder: { $name }
director-record-format = Format
director-record-format-mp4 = MP4 (H.264): spilles av overalt
director-record-format-prores = MOV (ProRes 422): for redigering
director-record-format-prores-alpha = MOV (ProRes 4443): gjennomsiktig bakgrunn
director-record-format-webm = WebM (VP9)
director-record-format-lossless = MKV (FFV1): tapsfri
director-record-fps = Bilder per sekund
director-record-quality = Kvalitet
director-record-quality-light = Lys
director-record-quality-good = Bra
director-record-quality-best = Best
director-record-alpha-tip = Med Isoler på en tom bakgrunn forblir det som er liggende tomt, gjennomsiktig i filmen.
director-record-no-sound = Filmen har ingen lyd.
director-record-start = Opptak
director-record-stop = Stopp opptaket
director-record-tip = Med spor: Spill av og film det til slutten. Uten spor: Film visningen til du trykker igjen. Filmen er 3D- visningen alene, uten grensesnittet.
director-record-unavailable = ffmpeg er nødvendig for å ta opp: se Opptak i Directors vinduet.
director-record-recording = Opptak { $time }
director-record-finishing = Fullfører fila …
director-record-saved = Film lagret: { $name }
director-record-failed = Filmen kunne ikke bli skrevet: { $why }
director-record-reveal = Vis i mappen
director-record-no-encoder = Denne ffmpeg kan ikke skrive til dette formatet: velg et annet format.
director-shake = Håndholdt kamera
director-shake-tip = Mens sporet spilles, kameraet driver og snur litt rundt sin bane, som en holdt i hånden.0: et stille kamera.
director-dof = Dybdeskarphet
director-dof-tip = Regissørens egen linse: skarp på låsens mål (eller på avstanden som er satt), uskarpt før og utover.
director-dof-aperture = Blenderåpning
director-dof-focus = Fokuslengde
director-dof-on-target = Fokusert på låsens mål.
director-tracks = Lagrede spor
director-track-name = Navn på dette sporet
director-track-save = Lagre
director-track-load = Last inn dette sporet (det som redigeres erstattes; Ctrl+Z bringer det tilbake)
director-track-none = Ingen spor lagret ennå.
director-track-saved = Lagret: { $name }
director-track-loaded = Lastet: { $name }
director-track-failed = Sporets fil kunne ikke brukes: { $why }
director-track-bad-name = Gi sporet et navn først.
# Director — shots
director-shots = Skudder
director-shot = Skudd
director-shot-orbit = Omløpsbane
director-shot-orbit-tip = Kameraet går rundt sentrum, ser på det, fra hvor det er nå.
director-shot-dolly-zoom = Dolly zoom
director-shot-dolly-zoom-tip = Kameraet kommer nærmere midten (eller beveger seg bort) mens objektivet utvides (eller blir smalere): Motivet beholder sin størrelse, bakgrunnen strekkes eller lukker seg inn.
director-shot-crane = Kran opp
director-shot-crane-tip = Kameraet stiger rett opp, fortsatt med blikket rettet mot midten.
director-shot-truck = Sporing
director-shot-truck-tip = Kameraet glir sidelengs, snudd som det er.
director-shot-push-in = Trykk inn
director-shot-push-in-tip = Kameraet beveger seg fremover langs utsikten, aldri forbi midten.
director-shot-pull-out = Trekk ut
director-shot-pull-out-tip = Kameraet beveger seg bakover langs utsikten.
director-shot-fly-over = Fly-over
director-shot-fly-over-tip = Kameraet passerer over midten og videre til den andre siden, ser fremover og ned.
director-shot-arc = Arc
director-shot-arc-tip = Hvor langt rundt sentrum kameraet går: 360 ° er en tur.
director-shot-duration = Varighet
director-shot-duration-tip = Sekunder skuddet varer.
director-shot-distance = Avstand
director-shot-distance-tip = Meter kameraet beveger seg.
director-shot-rise = Stig
director-shot-rise-tip = Meter kameraet stiger.
director-shot-over = Høyde over
director-shot-over-tip = Meter over sentrum kameraet passerer (over kameraets egen høyde når den er høyere).
director-shot-direction = Retning
director-shot-closer = Nærmere
director-shot-farther = Lengre unna
director-shot-left = Venstre
director-shot-right = Høyre
director-shot-ccw = Mot klokka
director-shot-cw = Med klokka
director-shot-around = Senter
director-shot-around-target = Låsens mål
director-shot-around-focus = Kameraets fokus
director-shot-around-tip = Hva bildet går rundt eller ser på: låsens mål når låsen er på og det er i sikte, ellers kameraets fokus (foran et fritt kamera eller flycam, ved dybdeskarphet avstanden).
director-shot-add = Etter banen
director-shot-replace = Erstatt sporet
director-shot-make = Ta bildet
director-shot-make-tip = Legger nøkkelbildene fra bildet i den gjeldende visningen, etter sporets siste nøkkelbild (kameraet flyr fra det til bildet) eller i stedet for sporet. De er nøkkelrammer som alle andre etterpå; Ctrl+Z tar hele bildet tilbake.
director-shot-no-room = Det er ikke plass til dette bildet herfra: kameraet er i midten, eller objektivet er allerede på grensen.
director-shot-full = Sporet har ikke plass til så mange flere keyframes.
director-shot-too-long = Sporet ville vare mer enn en time.
director-shot-made = Skudd lagt: { $count } nøkkelbilder, { $seconds } s. Spill av spiller den fra sin første nøkkelbilde.
director-shot-more = Flere valgmuligheter
director-shot-radius = Radius
director-shot-radius-tip = Baneavstanden fra sentrum, meter. Live: kameraets egen bane, slik at banen starter der den er.
director-shot-height = Høyde
director-shot-height-tip = Banehøyde over sentrum, meter. Live: kameraets egen høyde.
director-shot-live = Nivå: { $value } m
director-shot-set = Angi en egen verdi
director-shot-reset-live = Tilbake til liveverdien
director-shot-climb = Klatre
director-shot-climb-tip = Meter kameraet stiger (eller kommer ned) fra banens start til dens slutt: en spiral.
director-shot-travel = Reise med målet
director-shot-travel-tip = Keyframes i bildet beveger seg med låsens mål: en bane rundt en danser som går forblir rundt dem.
director-shot-travel-off = Bare med låsen på og målet i sikte.
director-key-ease = Lettelse
director-key-ease-tip = Hvordan kameraet starter og stopper på veien til denne keyframe fra den forrige. Banen og dens tid blir værende; enden som ikke er lettet beholder kurvenes hastighet.
director-ease-linear = Lineær
director-ease-in = Ease in
director-ease-out = Slapp av.
director-ease-in-out = Enkelt inn og ut
director-key-dolly-zoom = Dolly zoom
director-key-dolly-zoom-tip = På veien til denne nøkkelbilden endres objektivet med avstanden slik at et motiv foran beholder størrelsen sin: Gi de to nøkkelbildete sine objektiver, kameraet beveger seg rett mot motivet eller bort fra det.
director-key-travel = Reise med sitt mål
director-key-travel-tip = Denne nøkkelrammen beholder sin plass ved siden av målet når målet beveger seg (i verdensretningen), i stedet for å bli der den ble lagt. Oppdater legger den igjen fra gjeldende visning.
director-key-travel-none = Denne keyframe ser på ingen mål: gi den låsens mål først.
# Director — montage and tracks
director-zoom-in-tip = Zoom inn på tidslinjen (Ctrl + musehjul)
director-zoom-out-tip = Zoom ut (Ctrl + musehjul). Ikke tilgjengelig: hele sporet er allerede vist.
director-zoom-fit-tip = Vis hele sporet. Ikke tilgjengelig: det er allerede vist.
director-thumbnail-tip = Visningen av denne nøkkelrammen. Trykk: velg den Dobbeltklikk: gå dit (en nøkkelrame uten bilde får et der).
director-more-options = Flere valgmuligheter
director-library-import = Importer & # 160; …
director-library-import-tip = Legg til et spor eller en montasje fra en fil noen delte, til de lagrede (ingenting blir erstattet).
director-library-export = Eksporter & # 160; …
director-library-export-tip = Lagre sporet som redigeres til en fil etter eget valg, for å dele den.
director-library-export-empty = Sporet har ingen nøkkelbilde ennå.
director-library-export-name = spor
director-library-busy = Vent til filen blir lest eller skrevet.
director-library-save-tip = Lagre sporet som redigeres under dette navnet.
director-library-thumb-tip = Dens første utsikt, når et bilde av det ble tatt i denne økten.
director-library-length = { $time } s
director-library-rename-tip = Endre navn på dette sporet
director-library-rename-confirm = Endre navn
director-library-renamed = Endre navn: { $name }
director-library-name-taken = Et lagret spor er allerede kalt «% 1 »{ $name }”.
director-library-delete-tip = Slett dette sporet (spør først)
director-library-delete-confirm = Slett sporet?
director-library-delete-text = “{ $name }” er slettet fra denne datamaskinen. Dette kan ikke angres. Montagene som spiller det viser at det mangler.
director-library-delete = Slett
director-library-deleted = Slettet: { $name }
director-library-imported = Importert: { $name }
